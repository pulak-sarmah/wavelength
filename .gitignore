# --- OS ---
.DS_Store
Thumbs.db

# --- Env / secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- Node / Next.js (apps/web, packages/shared) ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/

# --- Python (apps/api, ml, recommendation) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Databases ---
*.db
*.sqlite3

# --- ML data & model artifacts (tracked via README + Git LFS/DVC later, not raw files) ---
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/models/*
!ml/models/.gitkeep
!ml/models/README.md

# --- Logs ---
*.log
