# Root-level environment variables shared across services in local dev.
# Copy to .env and fill in. Each app also has its own .env.example for
# service-specific settings (apps/web/.env.example, apps/api/.env.example).

# --- Database ---
# SQLite for local dev; swap for a Postgres URL later without code changes.
DATABASE_URL=sqlite:///./vibe.db

# --- Music provider (abstracted behind MusicProvider — see recommendation/) ---
# "mock" (default, no key needed) or "jamendo" (real open-content tracks —
# get a free client_id at https://devportal.jamendo.com).
MUSIC_PROVIDER=mock
# JAMENDO_CLIENT_ID=

# --- ML model artifacts ---
# Path to the versioned model directory the API loads at startup.
VIBE_MODEL_PATH=./ml/models/latest
