{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Track",
  "type": "object",
  "required": ["title", "artist", "provider"],
  "properties": {
    "title": { "type": "string" },
    "artist": { "type": "string" },
    "provider": { "type": "string" },
    "external_url": { "type": ["string", "null"] },
    "album_art_url": { "type": ["string", "null"] },
    "preview_url": { "type": ["string", "null"] }
  }
}
