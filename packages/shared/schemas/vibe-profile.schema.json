{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VibeProfile",
  "type": "object",
  "required": ["mood", "energy", "valence", "context", "social_energy", "vibe_tags", "confidence"],
  "properties": {
    "mood": {
      "type": "string",
      "enum": ["happy", "sad", "calm", "anxious", "angry", "excited", "romantic", "nostalgic", "neutral"]
    },
    "energy": {
      "type": "string",
      "enum": ["very_low", "low", "medium", "high", "very_high"]
    },
    "valence": {
      "type": "string",
      "enum": ["negative", "neutral", "positive"]
    },
    "context": {
      "type": "string",
      "enum": ["morning", "afternoon", "evening", "night", "unknown"]
    },
    "social_energy": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "vibe_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
